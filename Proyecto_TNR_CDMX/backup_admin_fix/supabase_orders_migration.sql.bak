-- ==============================================================================
-- PROYECTO TNR CDMX — DATABASE MIGRATION FOR PUBLIC.ORDERS
-- Run this migration in your Supabase SQL Editor (Dashboard -> SQL Editor -> New Query)
-- ==============================================================================

-- 1. Helper function to verify admin status safely (matches both UUID and TEXT user_id)
CREATE OR REPLACE FUNCTION public.is_admin()
RETURNS BOOLEAN
LANGUAGE sql
SECURITY DEFINER
SET search_path = public
STABLE
AS $$
  SELECT EXISTS (
    SELECT 1 FROM public.admin_users
    WHERE admin_users.user_id::text = auth.uid()::text
  );
$$;

-- 2. CREATE THE PUBLIC.ORDERS TABLE
-- Designed precisely for the frontend ordering payload and admin management view.
CREATE TABLE IF NOT EXISTS public.orders (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  reference_no TEXT UNIQUE NOT NULL,
  customer_name TEXT NOT NULL,
  customer_phone TEXT NOT NULL,
  customer_email TEXT DEFAULT '',
  delivery_address TEXT NOT NULL,
  city TEXT NOT NULL,
  notes TEXT DEFAULT '',
  total_amount NUMERIC(10, 2) NOT NULL DEFAULT 0,
  items JSONB NOT NULL DEFAULT '[]'::jsonb,
  status TEXT NOT NULL DEFAULT 'pending',
  stock_deducted BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- Upgrade existing columns if the table already existed with missing/not-null constraints
ALTER TABLE public.orders ALTER COLUMN customer_email DROP NOT NULL;
ALTER TABLE public.orders ALTER COLUMN customer_email SET DEFAULT '';
ALTER TABLE public.orders ALTER COLUMN notes DROP NOT NULL;
ALTER TABLE public.orders ALTER COLUMN notes SET DEFAULT '';
ALTER TABLE public.orders ADD COLUMN IF NOT EXISTS stock_deducted BOOLEAN DEFAULT FALSE;

-- 3. INDEXES FOR PERFORMANCE
CREATE INDEX IF NOT EXISTS idx_orders_reference_no ON public.orders(reference_no);
CREATE INDEX IF NOT EXISTS idx_orders_status ON public.orders(status);
CREATE INDEX IF NOT EXISTS idx_orders_created_at ON public.orders(created_at DESC);

-- 4. NON-NEGATIVE STOCK CONSTRAINT ON EXISTING PRODUCTS TABLE
-- Prevents inventory from ever dropping below zero
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_products_stock_non_negative') THEN
    ALTER TABLE public.products ADD CONSTRAINT chk_products_stock_non_negative CHECK (stock_quantity IS NULL OR stock_quantity >= 0);
  END IF;
END $$;

-- 5. ATOMIC INVENTORY DEDUCTION & VALIDATION TRIGGER
-- Acquires row locks (FOR UPDATE) inside the transaction, prevents race conditions/overselling,
-- and automatically deducts stock when an order is created.
CREATE OR REPLACE FUNCTION public.process_order_inventory()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  item RECORD;
  items_arr JSONB;
  p_id_text TEXT;
  p_id_uuid UUID;
  p_qty INT;
  cur_stock INT;
  prod_name TEXT;
BEGIN
  IF NEW.items IS NOT NULL THEN
    IF jsonb_typeof(NEW.items) = 'array' THEN
      items_arr := NEW.items;
    ELSIF jsonb_typeof(NEW.items) = 'string' THEN
      BEGIN
        items_arr := (NEW.items #>> '{}')::jsonb;
      EXCEPTION WHEN OTHERS THEN
        items_arr := '[]'::jsonb;
      END;
    ELSE
      items_arr := '[]'::jsonb;
    END IF;

    IF jsonb_typeof(items_arr) = 'array' THEN
      FOR item IN SELECT * FROM jsonb_to_recordset(items_arr) AS x(product_id TEXT, id TEXT, quantity INT, product_name TEXT)
      LOOP
        p_id_text := COALESCE(item.product_id, item.id);
        p_qty := COALESCE(item.quantity, 1);

        -- Validate UUID format before querying
        IF p_id_text IS NOT NULL AND p_id_text ~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' AND p_qty > 0 THEN
          p_id_uuid := p_id_text::UUID;

          -- Row-level lock FOR UPDATE
          SELECT stock_quantity, name INTO cur_stock, prod_name
          FROM public.products
          WHERE id = p_id_uuid
          FOR UPDATE;

          IF FOUND AND cur_stock IS NOT NULL THEN
            IF cur_stock < p_qty THEN
              RAISE EXCEPTION 'Insufficient stock for product "%": only % unit(s) available in stock, but % requested.', 
                COALESCE(prod_name, 'Product'), cur_stock, p_qty;
            END IF;

            -- Deduct stock atomically
            UPDATE public.products
            SET stock_quantity = stock_quantity - p_qty
            WHERE id = p_id_uuid;
          END IF;
        END IF;
      END LOOP;

      NEW.stock_deducted := TRUE;
    END IF;
  END IF;

  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_process_order_inventory ON public.orders;
CREATE TRIGGER trg_process_order_inventory
  BEFORE INSERT ON public.orders
  FOR EACH ROW
  EXECUTE FUNCTION public.process_order_inventory();

-- 6. ROW LEVEL SECURITY (RLS) POLICIES
-- Customers can submit orders securely without viewing, editing, or deleting any orders.
-- Authorized admins can view, update, and manage orders.
ALTER TABLE public.orders ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Public can insert orders" ON public.orders;
DROP POLICY IF EXISTS "Admins can view orders" ON public.orders;
DROP POLICY IF EXISTS "Admins can update orders" ON public.orders;
DROP POLICY IF EXISTS "Admins can delete orders" ON public.orders;

-- Anyone can submit an order (Guest & customer checkout supported)
CREATE POLICY "Public can insert orders"
  ON public.orders FOR INSERT
  TO public
  WITH CHECK (true);

-- Only authenticated administrators can view orders
CREATE POLICY "Admins can view orders"
  ON public.orders FOR SELECT
  TO authenticated
  USING (public.is_admin());

-- Only authenticated administrators can update orders (e.g. change status)
CREATE POLICY "Admins can update orders"
  ON public.orders FOR UPDATE
  TO authenticated
  USING (public.is_admin());

-- Only authenticated administrators can delete orders
CREATE POLICY "Admins can delete orders"
  ON public.orders FOR DELETE
  TO authenticated
  USING (public.is_admin());

-- 7. ADOPTION_REQUESTS TABLE (Included so adoption applications also save seamlessly)
CREATE TABLE IF NOT EXISTS public.adoption_requests (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  reference_no TEXT UNIQUE NOT NULL,
  applicant_name TEXT NOT NULL,
  applicant_phone TEXT NOT NULL,
  applicant_email TEXT DEFAULT '',
  address TEXT NOT NULL,
  city TEXT NOT NULL,
  notes TEXT DEFAULT '',
  animals JSONB NOT NULL DEFAULT '[]'::jsonb,
  status TEXT NOT NULL DEFAULT 'pending',
  created_at TIMESTAMPTZ DEFAULT now()
);

ALTER TABLE public.adoption_requests ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Public can insert adoption_requests" ON public.adoption_requests;
DROP POLICY IF EXISTS "Admins can view adoption_requests" ON public.adoption_requests;
DROP POLICY IF EXISTS "Admins can update adoption_requests" ON public.adoption_requests;
DROP POLICY IF EXISTS "Admins can delete adoption_requests" ON public.adoption_requests;

CREATE POLICY "Public can insert adoption_requests"
  ON public.adoption_requests FOR INSERT
  TO public
  WITH CHECK (true);

CREATE POLICY "Admins can view adoption_requests"
  ON public.adoption_requests FOR SELECT
  TO authenticated
  USING (public.is_admin());

CREATE POLICY "Admins can update adoption_requests"
  ON public.adoption_requests FOR UPDATE
  TO authenticated
  USING (public.is_admin());

CREATE POLICY "Admins can delete adoption_requests"
  ON public.adoption_requests FOR DELETE
  TO authenticated
  USING (public.is_admin());

-- 8. RELOAD SUPABASE POSTGREST SCHEMA CACHE
-- Tells PostgREST to immediately refresh its schema cache without restarting the database.
NOTIFY pgrst, 'reload schema';
